PORT=3005
DATABASE_URL=postgres://notification_user:notification_pass@localhost:5432/notification_db
RABBITMQ_URL=amqp://guest:guest@localhost:5672
LOG_LEVEL=info
EVENTS_EXCHANGE=skinsync.events
NOTIFICATION_QUEUE=notification.order-confirmed
# Max unacknowledged messages handled at once.
CONSUMER_PREFETCH=10
BROKER_RECONNECT_MS=5000
# Simulated latency of the mock email provider.
EMAIL_LATENCY_MS=100
