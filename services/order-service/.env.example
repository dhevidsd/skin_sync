PORT=3003
DATABASE_URL=postgres://order_user:order_pass@localhost:5432/order_db
CATALOG_SERVICE_URL=http://localhost:3001
PAYMENT_SERVICE_URL=http://localhost:3004
RABBITMQ_URL=amqp://guest:guest@localhost:5672
LOG_LEVEL=info
HTTP_TIMEOUT_MS=2000
# Payment calls: per-attempt timeout, attempts, and base delay for exponential backoff with jitter.
PAYMENT_TIMEOUT_MS=3000
PAYMENT_MAX_ATTEMPTS=3
PAYMENT_RETRY_BASE_MS=200
# How long a duplicate request waits for the first one (same Idempotency-Key) to finish.
IDEMPOTENCY_WAIT_MS=5000
EVENTS_EXCHANGE=skinsync.events
NOTIFICATION_QUEUE=notification.order-confirmed
OUTBOX_POLL_INTERVAL_MS=1000
BROKER_RECONNECT_MS=5000
