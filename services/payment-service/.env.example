PORT=3004
DATABASE_URL=postgres://payment_user:payment_pass@localhost:5432/payment_db
LOG_LEVEL=info
# Simulated gateway latency in ms and probability (0..1) that a charge is declined.
PAYMENT_LATENCY_MS=200
PAYMENT_FAILURE_RATE=0
# Allow the X-Payment-Simulate request header (fail | success | error | delay=<ms>) for demos.
ALLOW_SIMULATION_HEADER=true
